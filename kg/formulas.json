    {"name": "natural_log", "formula": "ln(x)", "sympy": "log(x)", "variables": {"x": "positive number"}, "category": "logarithm"},
    {"name": "log_base_10", "formula": "log₁₀(x)", "sympy": "log(x, 10)", "variables": {"x": "positive number"}, "category": "logarithm"},
