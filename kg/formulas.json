    {"name": "cos_degrees", "formula": "cos(x°)", "sympy": "cos(x * pi / 180)", "variables": {"x": "angle in degrees"}, "category": "trig"},
    {"name": "tan_degrees", "formula": "tan(x°)", "sympy": "tan(x * pi / 180)", "variables": {"x": "angle in degrees"}, "category": "trig"},
    {"name": "sin_radians", "formula": "sin(x) radians", "sympy": "sin(x)", "variables": {"x": "angle in radians"}, "category": "trig"},
    {"name": "cos_radians", "formula": "cos(x) radians", "sympy": "cos(x)", "variables": {"x": "angle in radians"}, "category": "trig"},
    {"name": "tan_radians", "formula": "tan(x) radians", "sympy": "tan(x)", "variables": {"x": "angle in radians"}, "category": "trig"},
    {"name": "arcsin_degrees", "formula": "arcsin(x) → degrees", "sympy": "asin(x) * 180 / pi", "variables": {"x": "value (-1 to 1)"}, "category": "trig"},
    {"name": "arccos_degrees", "formula": "arccos(x) → degrees", "sympy": "acos(x) * 180 / pi", "variables": {"x": "value (-1 to 1)"}, "category": "trig"},
    {"name": "arctan_degrees", "formula": "arctan(x) → degrees", "sympy": "atan(x) * 180 / pi", "variables": {"x": "value"}, "category": "trig"},
    {"name": "degrees_to_radians", "formula": "radians = degrees × π/180", "sympy": "x * pi / 180", "variables": {"x": "degrees"}, "category": "conversion"},
    {"name": "radians_to_degrees", "formula": "degrees = radians × 180/π", "sympy": "x * 180 / pi", "variables": {"x": "radians"}, "category": "conversion"}
  ],
  "combinatorics": [
    {"name": "factorial", "formula": "n!", "sympy": "factorial(n)", "variables": {"n": "non-negative integer"}, "category": "counting"},
    {"name": "permutation", "formula": "P(n,r) = n!/(n-r)!", "sympy": "factorial(n) / factorial(n - r)", "variables": {"n": "total items", "r": "chosen items"}, "category": "counting"},
    {"name": "combination", "formula": "C(n,r) = n!/(r!(n-r)!)", "sympy": "binomial(n, r)", "variables": {"n": "total items", "r": "chosen items"}, "category": "counting"}
  ],
  "number_theory": [
    {"name": "gcd", "formula": "GCD(a, b)", "sympy": "gcd(a, b)", "variables": {"a": "first integer", "b": "second integer"}, "category": "divisibility"},
    {"name": "lcm", "formula": "LCM(a, b)", "sympy": "lcm(a, b)", "variables": {"a": "first integer", "b": "second integer"}, "category": "divisibility"}
  ],
