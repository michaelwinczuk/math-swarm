{
  "algebra": [
    {"name": "quadratic_formula", "formula": "x = (-b ± sqrt(b² - 4ac)) / 2a", "sympy": "(-b + sqrt(b**2 - 4*a*c)) / (2*a)", "variables": {"a": "coefficient of x²", "b": "coefficient of x", "c": "constant"}, "precondition": "b**2 - 4*a*c >= 0 for real roots", "category": "equation_solving"},
    {"name": "linear_equation", "formula": "y = mx + b", "sympy": "m*x + b", "variables": {"m": "slope", "b": "y-intercept", "x": "independent variable"}, "category": "equation_solving"},
    {"name": "distance_formula", "formula": "d = sqrt((x2-x1)² + (y2-y1)²)", "sympy": "sqrt((x2-x1)**2 + (y2-y1)**2)", "variables": {"x1": "point 1 x", "y1": "point 1 y", "x2": "point 2 x", "y2": "point 2 y"}, "category": "geometry"},
    {"name": "percentage", "formula": "result = base × (percent/100)", "sympy": "base * percent / 100", "variables": {"base": "original value", "percent": "percentage"}, "category": "arithmetic"},
    {"name": "percentage_change", "formula": "change = ((new - old) / old) × 100", "sympy": "((new_val - old_val) / old_val) * 100", "variables": {"new_val": "new value", "old_val": "original value"}, "category": "arithmetic"},
    {"name": "compound_growth", "formula": "A = P(1 + r)^t", "sympy": "P * (1 + r)**t", "variables": {"P": "principal", "r": "rate per period", "t": "number of periods"}, "category": "growth"}
  ],
  "finance": [
    {"name": "compound_interest", "formula": "A = P(1 + r/n)^(nt)", "sympy": "P * (1 + r/n)**(n*t)", "variables": {"P": "principal", "r": "annual rate (decimal)", "n": "compounds per year", "t": "years"}, "category": "interest"},
    {"name": "simple_interest", "formula": "I = P × r × t", "sympy": "P * r * t", "variables": {"P": "principal", "r": "annual rate (decimal)", "t": "years"}, "category": "interest"},
    {"name": "mortgage_payment", "formula": "M = P[r(1+r)^n]/[(1+r)^n - 1]", "sympy": "P * (r * (1+r)**n) / ((1+r)**n - 1)", "variables": {"P": "loan amount", "r": "monthly rate (annual/12)", "n": "total months"}, "category": "loan"},
    {"name": "present_value", "formula": "PV = FV / (1+r)^t", "sympy": "FV / (1+r)**t", "variables": {"FV": "future value", "r": "discount rate", "t": "periods"}, "category": "valuation"},
    {"name": "roi", "formula": "ROI = (gain - cost) / cost × 100", "sympy": "((gain - cost) / cost) * 100", "variables": {"gain": "total return", "cost": "total investment"}, "category": "performance"},
    {"name": "break_even", "formula": "BEP = fixed_costs / (price - variable_cost)", "sympy": "fixed_costs / (price - variable_cost)", "variables": {"fixed_costs": "total fixed costs", "price": "unit selling price", "variable_cost": "unit variable cost"}, "category": "business"},
    {"name": "sharpe_ratio", "formula": "S = (Rp - Rf) / σp", "sympy": "(Rp - Rf) / sigma_p", "variables": {"Rp": "portfolio return", "Rf": "risk-free rate", "sigma_p": "portfolio std dev"}, "category": "risk"},
    {"name": "apr_to_apy", "formula": "APY = (1 + APR/n)^n - 1", "sympy": "(1 + apr/n)**n - 1", "variables": {"apr": "annual percentage rate", "n": "compounding periods"}, "category": "interest"}
  ],
  "statistics": [
    {"name": "mean", "formula": "μ = Σx / n", "sympy": "sum(x) / len(x)", "variables": {"x": "data values", "n": "count"}, "category": "descriptive"},
    {"name": "standard_deviation", "formula": "σ = sqrt(Σ(x-μ)² / n)", "sympy": "sqrt(sum((xi - mean)**2 for xi in x) / len(x))", "variables": {"x": "data values", "mean": "arithmetic mean"}, "category": "descriptive"},
    {"name": "z_score", "formula": "z = (x - μ) / σ", "sympy": "(x - mu) / sigma", "variables": {"x": "value", "mu": "mean", "sigma": "std dev"}, "category": "normalization"},
    {"name": "bayes_theorem", "formula": "P(A|B) = P(B|A)P(A) / P(B)", "sympy": "p_b_given_a * p_a / p_b", "variables": {"p_b_given_a": "P(B|A)", "p_a": "P(A)", "p_b": "P(B)"}, "category": "probability"},
    {"name": "expected_value", "formula": "E[X] = Σ(x × P(x))", "sympy": "sum(x * p for x, p in zip(values, probs))", "variables": {"values": "outcomes", "probs": "probabilities"}, "category": "probability"}
  ],
  "physics": [
    {"name": "velocity", "formula": "v = d / t", "sympy": "d / t", "variables": {"d": "distance", "t": "time"}, "category": "kinematics"},
    {"name": "kinetic_energy", "formula": "KE = ½mv²", "sympy": "Rational(1,2) * m * v**2", "variables": {"m": "mass (kg)", "v": "velocity (m/s)"}, "category": "energy"},
    {"name": "force", "formula": "F = ma", "sympy": "m * a", "variables": {"m": "mass (kg)", "a": "acceleration (m/s²)"}, "category": "mechanics"},
    {"name": "ohms_law", "formula": "V = IR", "sympy": "I * R", "variables": {"I": "current (amps)", "R": "resistance (ohms)"}, "category": "electrical"},
    {"name": "power", "formula": "P = W / t", "sympy": "W / t", "variables": {"W": "work (joules)", "t": "time (seconds)"}, "category": "energy"}
  ],
  "geometry": [
    {"name": "circle_area", "formula": "A = πr²", "sympy": "pi * r**2", "variables": {"r": "radius"}, "category": "area"},
    {"name": "sphere_volume", "formula": "V = (4/3)πr³", "sympy": "Rational(4,3) * pi * r**3", "variables": {"r": "radius"}, "category": "volume"},
    {"name": "pythagorean", "formula": "c² = a² + b²", "sympy": "sqrt(a**2 + b**2)", "variables": {"a": "side a", "b": "side b"}, "category": "triangle"},
    {"name": "triangle_area", "formula": "A = ½bh", "sympy": "Rational(1,2) * b * h", "variables": {"b": "base", "h": "height"}, "category": "area"},
    {"name": "cylinder_volume", "formula": "V = πr²h", "sympy": "pi * r**2 * h", "variables": {"r": "radius", "h": "height"}, "category": "volume"}
  ],
  "conversion": [
    {"name": "celsius_to_fahrenheit", "formula": "F = C × 9/5 + 32", "sympy": "c * Rational(9,5) + 32", "variables": {"c": "celsius"}, "category": "temperature"},
    {"name": "km_to_miles", "formula": "miles = km × 0.621371", "sympy": "km * 0.621371", "variables": {"km": "kilometers"}, "category": "distance"},
    {"name": "kg_to_lbs", "formula": "lbs = kg × 2.20462", "sympy": "kg * 2.20462", "variables": {"kg": "kilograms"}, "category": "weight"},
    {"name": "bytes_to_gb", "formula": "GB = bytes / 1073741824", "sympy": "b / 1073741824", "variables": {"b": "bytes"}, "category": "data"}
  ],
  "trigonometry": [
