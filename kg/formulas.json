  ],
  "healthcare": [
    {"name": "bmi", "formula": "BMI = weight(kg) / height(m)²", "sympy": "weight / height**2", "variables": {"weight": "weight in kg", "height": "height in meters"}, "category": "vitals"},
    {"name": "map", "formula": "MAP = (SBP + 2×DBP) / 3", "sympy": "(SBP + 2*DBP) / 3", "variables": {"SBP": "systolic BP mmHg", "DBP": "diastolic BP mmHg"}, "category": "vitals"},
    {"name": "corrected_calcium", "formula": "Ca_corr = Ca + 0.8 × (4.0 - albumin)", "sympy": "Ca + Rational(8,10) * (4 - albumin)", "variables": {"Ca": "measured calcium mg/dL", "albumin": "serum albumin g/dL"}, "category": "labs"},
    {"name": "anion_gap", "formula": "AG = Na - (Cl + HCO3)", "sympy": "Na - (Cl + HCO3)", "variables": {"Na": "sodium mEq/L", "Cl": "chloride mEq/L", "HCO3": "bicarbonate mEq/L"}, "category": "labs"},
    {"name": "cockcroft_gault_male", "formula": "CrCl = (140-age) × weight / (72 × Cr)", "sympy": "(140 - age) * weight / (72 * Cr)", "variables": {"age": "years", "weight": "weight in kg", "Cr": "serum creatinine mg/dL"}, "category": "renal"},
    {"name": "cockcroft_gault_female", "formula": "CrCl = (140-age) × weight × 0.85 / (72 × Cr)", "sympy": "(140 - age) * weight * Rational(85,100) / (72 * Cr)", "variables": {"age": "years", "weight": "weight in kg", "Cr": "serum creatinine mg/dL"}, "category": "renal"},
    {"name": "meld_score", "formula": "MELD = 10 × (0.957×ln(Cr) + 0.378×ln(Bili) + 1.120×ln(INR) + 0.643)", "sympy": "10 * (Rational(957,1000)*log(Cr) + Rational(378,1000)*log(Bili) + Rational(1120,1000)*log(INR) + Rational(643,1000))", "variables": {"Cr": "creatinine mg/dL", "Bili": "bilirubin mg/dL", "INR": "international normalized ratio"}, "category": "hepatic"},
    {"name": "qtc_bazett", "formula": "QTc = QT / √(RR) where RR = 60/HR", "sympy": "QT / sqrt(Rational(60,1)/HR)", "variables": {"QT": "QT interval ms", "HR": "heart rate bpm"}, "category": "cardiac"},
    {"name": "pediatric_dose", "formula": "Dose = weight × dose_per_kg", "sympy": "weight * dose_per_kg", "variables": {"weight": "weight in kg", "dose_per_kg": "mg per kg"}, "category": "dosing"},
    {"name": "iv_drip_rate", "formula": "Rate(mL/hr) = Volume / Time", "sympy": "volume / time", "variables": {"volume": "volume in mL", "time": "time in hours"}, "category": "dosing"},
    {"name": "ibw_male", "formula": "IBW(kg) = 50 + 2.3 × (height_in - 60)", "sympy": "50 + Rational(23,10) * (height_in - 60)", "variables": {"height_in": "height in inches"}, "category": "dosing"},
    {"name": "ibw_female", "formula": "IBW(kg) = 45.5 + 2.3 × (height_in - 60)", "sympy": "Rational(455,10) + Rational(23,10) * (height_in - 60)", "variables": {"height_in": "height in inches"}, "category": "dosing"},
    {"name": "aa_gradient", "formula": "A-a = (FiO2×713 - PaCO2/0.8) - PaO2", "sympy": "(FiO2 * 713 - PaCO2 / Rational(4,5)) - PaO2", "variables": {"FiO2": "fraction inspired O2 (0.21-1.0)", "PaCO2": "arterial CO2 mmHg", "PaO2": "arterial O2 mmHg"}, "category": "pulmonary"},
    {"name": "egfr_male", "formula": "eGFR = 142 × min(Cr/0.9,1)^-0.302 × max(Cr/0.9,1)^-1.200 × 0.9938^age", "sympy": "142 * Min(Cr/Rational(9,10), 1)**Rational(-302,1000) * Max(Cr/Rational(9,10), 1)**Rational(-1200,1000) * Rational(9938,10000)**age", "variables": {"Cr": "serum creatinine mg/dL", "age": "years"}, "category": "renal"},
    {"name": "egfr_female", "formula": "eGFR = 142 × min(Cr/0.7,1)^-0.241 × max(Cr/0.7,1)^-1.200 × 0.9938^age × 1.012", "sympy": "142 * Min(Cr/Rational(7,10), 1)**Rational(-241,1000) * Max(Cr/Rational(7,10), 1)**Rational(-1200,1000) * Rational(9938,10000)**age * Rational(1012,1000)", "variables": {"Cr": "serum creatinine mg/dL", "age": "years"}, "category": "renal"}
  ]
}
